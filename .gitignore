# Generated by Cargo
# Will have compiled binaries and intermediate build artifacts
/target/

# Compiled binaries — users build from source
*.exe

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows debugging files
*.pdb

# Local environment & secrets
.env
.env.*
*.secret

# IDE and Editor configs
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.vs/

# OS generated files
Thumbs.db
[Dd]esktop.ini
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db

# Logs & crash dumps
*.log
*.dump
crash.dmp

# Temporary test traces
*.timeline.html
*.trace.json
*.gen.c
